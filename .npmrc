# React Native's Metro bundler does not understand pnpm's symlinked store.
# It resolves transitive dependencies by walking node_modules directories on
# disk, so a package that expo-router or react-native requires but does not
# declare is simply not found — the failure surfaces as a runtime crash in
# Expo Go ("Something went wrong"), not as an install error.
#
# Expo's documented answer for pnpm monorepos. It costs pnpm's strictness
# about undeclared dependencies; that protection is worth less than a
# bundler that works, and the invariant gate does not depend on it.
node-linker=hoisted
